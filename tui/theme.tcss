/* theme.tcss — palette "Bloomberg rétro" (blueprint section 4.1).
   Ces valeurs hexadécimales sont dupliquées en commentaire dans tui/app.py
   (styles appliqués aux cellules du DataTable selon le statut) : si tu changes
   une couleur ici, mets aussi à jour STATUS_COLORS dans tui/app.py. */

$bg-main: #000000;
$bg-panel: #0a0a0a;
$bg-selected: #1a1a1a;
$fg-primary: #FFB000;
$fg-secondary: #E8E8E8;
$fg-header: #00C8FF;
$fg-command: #FFD500;
$fg-done: #00D26A;
$fg-urgent: #FF3B3B;
$fg-muted: #5C5C5C;
$border-color: #FFB000;

Screen {
    background: $bg-main;
    color: $fg-secondary;
}

/* ---- bandeau du haut : horloge + compteurs ---- */
HeaderBar {
    height: 3;
    background: $bg-main;
    color: $fg-secondary;
    border-bottom: solid $border-color;
    padding: 0 2;
    /* border-bottom consomme 1 des 3 lignes de la hauteur totale : il ne
       reste que 2 lignes de contenu, un nombre pair pour un texte tenant
       sur 1 seule ligne — "middle" ne peut alors que retomber sur le haut
       (aucune ligne pile au centre de 2). "bottom" pousse le texte contre
       la bordure du bas à la place : 1 ligne vide au-dessus, texte juste
       avant le filet — visuellement centré dans le bandeau plutôt que
       collé en haut. */
    content-align: left bottom;
    /* Terminal étroit : couper net plutôt que passer à la ligne — un
       bandeau sur 2 lignes écraserait la première ligne du tableau. */
    text-wrap: nowrap;
    text-overflow: clip;
}

/* ---- corps : sidebar + table ---- */
#body {
    height: 1fr;
}

#sidebar {
    width: 20;
    background: $bg-panel;
    border-right: solid $border-color;
    padding: 1 0;
}

.sidebar-item {
    padding: 0 2;
    height: 1;
    color: $fg-secondary;
}

.sidebar-item.-active {
    background: $bg-selected;
    color: $fg-primary;
    text-style: bold;
}

/* Round 18 : filtre "par adjudication", propre à la vue Tâches — vit dans
   la sidebar existante (déjà 20 colonnes fixes, empilement vertical) plutôt
   que dans le bandeau du haut (rendu Rich sur une seule ligne, pas de vrais
   widgets interactifs) : n'ajoute rien à un layout existant, juste du
   contenu de plus dans un conteneur qui existait déjà, masqué (Select.display)
   côté vue Adjudications. Largeur fixe de la sidebar = déjà insensible à la
   largeur du terminal, contrairement au bandeau du haut qui doit abréger son
   contenu en dessous d'un certain seuil — c'est ce qui rend ce filtre
   utilisable même dans une fenêtre étroite sans traitement supplémentaire. */
.sidebar-filter-label {
    padding: 0 2;
    height: 1;
}

#sidebar Select {
    width: 1fr;
    margin: 0 1;
}

#sidebar SelectCurrent,
#sidebar Select:focus > SelectCurrent {
    border: none;
    background: $bg-selected;
    color: $fg-secondary;
    padding: 0 1;
}

#sidebar SelectOverlay {
    border: solid $border-color;
    background: $bg-panel;
}

#main-table {
    background: $bg-panel;
    color: $fg-secondary;
    scrollbar-background: $bg-panel;
    scrollbar-background-hover: $bg-panel;
    scrollbar-background-active: $bg-panel;
    /* Barre horizontale plus discrète : déjà à l'épaisseur minimale (1
       ligne, valeur par défaut de Textual — impossible d'aller plus fin
       dans une grille de terminal), donc "plus fine" ne peut passer que par
       moins de contraste au repos : une teinte adoucie (35% d'opacité)
       plutôt que l'ambre plein, qui ressortait comme une barre pleine et
       épaisse sur les vues avec peu de lignes. Toujours amber franc au
       survol/glissement pour rester repérable quand on l'utilise. */
    scrollbar-color: $border-color 35%;
    scrollbar-color-hover: $fg-primary;
    scrollbar-color-active: $fg-primary;
    scrollbar-corner-color: $bg-panel;
}

/* Cause réelle des "bandes" : le CSS intégré de Textual applique par défaut
   `DataTable:focus { background-tint: $foreground 5%; }`, qui éclaircit TOUT
   le fond du tableau (~#141414 au lieu de $bg-panel #0a0a0a) dès qu'il a le
   focus — pas la ligne sous le curseur (qui a son propre fond peint par
   dessus, donc épargnée), mais toutes les autres. D'où l'impression de
   bandes autour d'une ligne "normale". Neutralisé ici : fond strictement
   uniforme sur tout le tableau, focus ou non. */
DataTable:focus {
    background-tint: $foreground 0%;
}

/* Deuxième source de "bandes", distincte de background-tint ci-dessus : le
   CSS intégré de Textual applique aussi un vrai zébrage une-ligne-sur-deux
   (`.datatable--even-row { background: $surface-lighten-1 50%; }`, et une
   variante encore différente en mode sombre via `:dark`). Neutralisé ici
   pour les deux variantes : fond strictement identique à $bg-panel sur
   toutes les lignes, paires ou impaires. */
DataTable > .datatable--even-row,
DataTable:dark > .datatable--even-row {
    background: $bg-panel;
}

DataTable > .datatable--header,
DataTable:focus > .datatable--header {
    background: $bg-main;
    color: $fg-header;
    text-style: bold;
    /* Même cause que DataTable:focus plus haut : Textual retinte aussi
       spécifiquement l'en-tête (background-tint: $foreground 5%) quand le
       tableau a le focus — neutralisé pour un en-tête parfaitement uniforme
       lui aussi. */
    background-tint: $foreground 0%;
}

DataTable > .datatable--cursor,
DataTable:focus > .datatable--cursor {
    /* Round 23 (suite) : jusqu'ici pas de surlignage du tout — un choix
       raisonnable tant que le curseur ne servait qu'en interne (avant la
       navigation aux flèches du round 23, F5/F6 ne portaient toujours que
       sur la première ligne, la position du curseur importait peu). Devenu
       un vrai manque une fois la navigation ligne par ligne utilisable :
       Augustin signale qu'il ne peut plus repérer sur quelle ligne il se
       trouve. Fond légèrement éclairci ($bg-selected, #1a1a1a — déjà utilisé
       ailleurs dans l'app comme fond "sélectionné", ex. sidebar/modales
       plates) pour un surlignage discret mais visible.
       Bien distinct de la cause des "bandes" corrigée au round 5 (le
       background-tint de DataTable:focus, qui éclaircissait TOUTES les
       lignes sauf le curseur, et un zébrage une-ligne-sur-deux) : ici,
       exactement l'inverse — une seule ligne, celle du curseur, reçoit un
       traitement différent ; tout le reste du tableau garde le fond uniforme
       $bg-panel comme avant. `text-style: none` conservé (la règle intégrée
       à Textual mettrait sinon le texte en gras via block-cursor-text-style,
       cause du bug repéré au round 8) — seule la couleur de fond change,
       jamais le poids du texte ; la couleur du texte (rouge/vert/blanc selon
       le statut) reste elle aussi intacte grâce à cursor_foreground_priority
       ="renderable" (tui/app.py), donc la nouvelle surbrillance ne fait
       jamais concurrence au code couleur du statut. */
    background: $bg-selected;
    text-style: none;
}

DataTable > .datatable--fixed {
    background: $bg-main;
}

/* ---- barre de commande façon <GO> ---- */
CommandBar {
    height: 3;
    border-top: solid $border-color;
    background: $bg-main;
    color: $fg-command;
    padding: 0 1;
}

CommandBar Input {
    background: $bg-main;
    color: $fg-command;
    border: none;
}

CommandBar Input:focus {
    border: none;
}

/* ---- footer de raccourcis ---- */
Footer {
    background: $bg-panel;
    color: $fg-secondary;
}

FooterKey {
    background: $bg-panel;
    color: $fg-secondary;
}

FooterKey > .footer-key--key {
    background: $fg-primary;
    color: $bg-main;
    text-style: bold;
}

FooterKey > .footer-key--description {
    background: $bg-panel;
    color: $fg-secondary;
}

/* ---- modaux (formulaires, confirmations, aide) ---- */
ModalScreen {
    align: center middle;
    background: $bg-main 60%;
}

.modal-box {
    width: 64;
    /* Vertical (DEFAULT_CSS de Textual) est "height: 1fr" par défaut, donc
       s'étire tout seul sur toute la hauteur disponible de l'écran même
       centré via ModalScreen { align: center middle }. Sans ce héight:auto
       explicite, toute modale se retrouve avec une grande zone vide en bas
       — particulièrement visible/gênant pour une modale voulue "petite et
       discrète" comme TaskDetailModal. */
    height: auto;
    background: $bg-panel;
    border: solid $border-color;
    padding: 1 2;
}

.modal-title {
    color: $fg-primary;
    text-style: bold;
    margin-bottom: 1;
}

.field-label {
    color: $fg-header;
    margin-top: 1;
}

.field-error {
    color: $fg-urgent;
    height: 1;
}

.modal-buttons {
    margin-top: 1;
    height: 3;
    align: right middle;
}

.modal-buttons Button {
    margin-left: 1;
}

/* ---- modales "plates" (TaskDetailModal, clic/Entrée sur une tâche ;
   TaskFormModal, ajout de tâche ; AuctionFormModal, ajout/clic sur une
   adjudication — round 14) ----
   Plus discrètes qu'un formulaire par défaut (.modal-box seul, utilisé par
   les confirmations) : lignes d'info compactes, boutons réduits au minimum
   (pas de gros bloc coloré primary/error — juste une couleur de texte,
   comme le reste de l'interface). -form et -form-wide sont identiques à
   -detail, juste plus larges (plus de champs qu'une simple fiche) —
   -form-wide un peu plus que -form : le formulaire d'adjudication porte
   encore plus de champs que celui d'une tâche.

   Un seul cadre visible dans toute la modale : celui de .modal-box (noir,
   bordure ambre). Les champs internes (Input, Select, Checkbox) sont tous
   stylés sans bordure propre juste en dessous — sinon chacun dessine sa
   propre boîte par défaut (bordure Textual standard) et ça donne l'effet
   "boîtes dans la boîte" qui posait problème. */
.modal-box.-detail {
    width: 50;
    padding: 1 2;
}

.modal-box.-form {
    width: 56;
    padding: 1 2;
}

.modal-box.-form-wide {
    width: 64;
    padding: 1 2;
}

.detail-line {
    color: $fg-secondary;
    height: 1;
}

/* Round 18 : ligne discrète (indicateur de provenance d'une tâche dans
   TaskDetailModal) — même famille que .detail-line, juste atténuée pour ne
   pas rivaliser visuellement avec la ligne date/heure/détails juste
   au-dessus. */
.detail-line.-muted {
    color: $fg-muted;
}

.modal-box.-detail Input,
.modal-box.-form Input,
.modal-box.-form-wide Input {
    border: none;
    background: $bg-selected;
    color: $fg-secondary;
    padding: 0 1;
    height: 1;
}

.modal-box.-detail Input:focus,
.modal-box.-form Input:focus,
.modal-box.-form-wide Input:focus {
    border: none;
    background: $bg-selected;
}

.modal-box.-detail SelectCurrent,
.modal-box.-detail Select:focus > SelectCurrent,
.modal-box.-form SelectCurrent,
.modal-box.-form Select:focus > SelectCurrent,
.modal-box.-form-wide SelectCurrent,
.modal-box.-form-wide Select:focus > SelectCurrent {
    border: none;
    background: $bg-selected;
    color: $fg-secondary;
    padding: 0 1;
}

.modal-box.-detail SelectOverlay,
.modal-box.-form SelectOverlay,
.modal-box.-form-wide SelectOverlay {
    border: solid $border-color;
    background: $bg-panel;
}

.modal-box.-detail Checkbox,
.modal-box.-form Checkbox,
.modal-box.-form-wide Checkbox {
    border: none;
    background: $bg-selected;
    color: $fg-secondary;
    padding: 0 1;
}

.modal-box.-detail Checkbox:focus,
.modal-box.-form Checkbox:focus,
.modal-box.-form-wide Checkbox:focus {
    border: none;
    background: $bg-selected;
}

.detail-recurrence {
    height: 1;
    margin-top: 0;
}

.detail-recurrence > #f-recurrence {
    width: 1fr;
}

.detail-recurrence > #f-weekday {
    width: 14;
    margin-left: 1;
}

.modal-box.-detail Button.-link-btn,
.modal-box.-form Button.-link-btn,
.modal-box.-form-wide Button.-link-btn {
    border: none;
    background: $bg-panel;
    color: $fg-muted;
    height: 1;
    min-width: 0;
    width: auto;
    text-style: none;
    margin-top: 0;
    padding: 0;
}

.modal-box.-detail Button.-link-btn:hover,
.modal-box.-form Button.-link-btn:hover,
.modal-box.-form-wide Button.-link-btn:hover {
    background: $bg-panel;
    color: $fg-urgent;
    text-style: underline;
}

.modal-buttons.-compact {
    height: 1;
    margin-top: 1;
}

/* -split (AuctionFormModal, round 15) : un bouton auxiliaire ("Vérifier les
   tâches liées") callé à l'extrême gauche du cadre, Annuler/Valider restant
   groupés à droite comme d'habitude. .modal-buttons de base pose déjà
   `align: right middle` (confirmations classiques) ; -split le neutralise en
   alignant le container à gauche et confie l'écartement à un Static -spacer
   (width: 1fr) placé entre le bouton de gauche et le groupe de droite, qui
   absorbe tout l'espace restant. Sélecteur à 3 classes pour primer sans
   ambiguïté sur .modal-buttons (align: right middle) et .modal-buttons.
   -compact (ne redéfinit pas align). Fonctionne aussi sans bouton de gauche
   (mode ajout : le spacer capte alors tout l'espace avant Annuler/Valider,
   résultat identique à un simple alignement à droite). */
.modal-buttons.-compact.-split {
    align: left middle;
}

.modal-buttons.-compact.-split > .-spacer {
    width: 1fr;
    height: 1;
}

.modal-buttons.-compact Button {
    min-width: 8;
    width: auto;
    height: 1;
    border: none;
    background: $bg-panel;
    color: $fg-secondary;
    text-style: none;
    margin-left: 1;
}

.modal-buttons.-compact Button:hover {
    background: $bg-panel;
    color: $fg-primary;
    text-style: underline;
}

.modal-buttons.-compact Button.-delete-btn {
    color: $fg-urgent;
}

.modal-buttons.-compact Button.-done-btn {
    color: $fg-done;
}

/* Action principale d'un formulaire (ex. "Valider") : même sobriété que le
   reste (texte seul, pas de bloc plein comme l'ancien variant="primary"),
   juste la couleur ambre du thème pour rester repérable comme action par
   défaut. */
.modal-buttons.-compact Button.-primary-btn {
    color: $fg-primary;
}

Input.-invalid {
    border: tall $fg-urgent;
}

Input.-valid {
    border: tall $border-color;
}
